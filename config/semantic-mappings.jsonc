      { "tile": "overlay_grime_floor_01_19", "weight": 26 },
      { "tile": "overlay_grime_floor_01_18", "weight": 22 }
    ] },
    { "id": "procedural.road-wear.cracks", "semantic": "procedural.road-wear", "when": { "surface": "road", "effect": "crack" }, "layer": "FloorOverlay", "role": "surface-overlay", "variants": [
