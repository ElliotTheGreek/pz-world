      { "tile": "vegetation_farm_01_42", "weight": 5024 },
      { "tile": "vegetation_farm_01_32", "weight": 4964 }
    ] },
    { "id": "procedural.rock.outcrop", "semantic": "procedural.rock", "when": { "topology": "ridge" }, "layer": "Furniture", "role": "decoration", "contextRequired": true, "variants": [
      { "tile": "boulders_54", "weight": 1 }, { "tile": "boulders_48", "weight": 1 },
      { "tile": "boulders_52", "weight": 1 }, { "tile": "boulders_9", "weight": 1 }
    ], "exclusions": ["boulders_40..47 are floor plates, not loose objects, and cannot be stacked over authored ground."] },
    { "id": "procedural.road-wear.grime", "semantic": "procedural.road-wear", "when": { "surface": ["road", "gravel"], "effect": "grime" }, "layer": "FloorOverlay", "role": "surface-overlay", "variants": [
      { "tile": "overlay_grime_floor_01_28", "weight": 1370 },
      { "tile": "overlay_grime_floor_01_29", "weight": 1244 },
      { "tile": "overlay_grime_floor_01_1", "weight": 558 },
      { "tile": "overlay_grime_floor_01_0", "weight": 437 },
